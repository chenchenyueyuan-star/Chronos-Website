# Copy to .env.local. Never commit real API keys.
GEMINI_API_KEY=
ELEVENLABS_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
ELEVENLABS_TTS_MODEL=eleven_multilingual_v2
# Copy voice IDs from your ElevenLabs account for the narrator labels.
ELEVENLABS_MALE_VOICE_1_ID=
ELEVENLABS_MALE_VOICE_1_WHISPER_ID=
ELEVENLABS_MALE_VOICE_2_ID=
ELEVENLABS_MALE_VOICE_2_WHISPER_ID=
ELEVENLABS_FEMALE_VOICE_1_ID=
ELEVENLABS_FEMALE_VOICE_1_WHISPER_ID=
ELEVENLABS_FEMALE_VOICE_2_ID=
ELEVENLABS_FEMALE_VOICE_2_WHISPER_ID=
# Optional Google sign-in
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional signed-in camera measurements
PRESAGE_API_KEY=
